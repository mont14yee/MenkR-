# ==============================================================================
# MenkR- Production & Development Environment Configuration
# NOTE: Do NOT commit production secrets or credentials to source control.
# All values below are sample placeholders for configuration guidance.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL="https://example-app.run.app"

# ------------------------------------------------------------------------------
# 2. Database (Cloud SQL / PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Option A: Connection string (Recommended for Cloud SQL UNIX sockets or container networks)
DATABASE_URL="postgresql://menkir_user:replace_with_db_password@localhost:5432/menkir_db?sslmode=prefer"

# Option B: Discrete credentials (used if DATABASE_URL is not set)
SQL_HOST="localhost"
SQL_USER="menkir_user"
SQL_PASSWORD="replace_with_db_password"
SQL_DB_NAME="menkir_db"

# ------------------------------------------------------------------------------
# 3. AI Provider Configuration (Google Gemini)
# ------------------------------------------------------------------------------
# Server-side API key for Google Gemini (models/gemini-3.8-flash)
# CRITICAL: Keep this strictly server-side. Never prefix with VITE_ or expose in client.
GEMINI_API_KEY="AIzaSy_YOUR_SERVER_SIDE_GEMINI_KEY_HERE"

# ------------------------------------------------------------------------------
# 4. Client Authentication (Firebase Auth / Optional)
# ------------------------------------------------------------------------------
# Public Firebase client configurations (safe for browser exposure).
# Required only if client-side Firebase Auth is configured.
VITE_FIREBASE_API_KEY="AIzaSy_SAMPLE_CLIENT_KEY"
VITE_FIREBASE_AUTH_DOMAIN="sample-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sample-project"
